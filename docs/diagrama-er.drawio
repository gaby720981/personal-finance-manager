        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    usuarios ||--o{ cuentas : tiene\n    usuarios ||--o{ categorias : define\n    usuarios ||--o{ movimientos : registra\n    cuentas ||--o{ movimientos : afecta\n    categorias o|--o{ movimientos : clasifica\n\n    usuarios ||--o{ transferencias : realiza\n    transferencias ||--o{ movimientos : agrupa\n\n    usuarios ||--o{ deudas : tiene\n    deudas ||--o{ pagos_deuda : recibe\n    movimientos ||--o| pagos_deuda : representa\n\n    usuarios ||--o{ facturas : recibe\n    facturas ||--o{ pagos_factura : recibe\n    movimientos ||--o| pagos_factura : representa\n\n    facturas ||--o{ recordatorios : genera\n\n    usuarios {\n        bigint id PK\n        varchar nombre\n        timestamp created_at\n    }\n\n    cuentas {\n        bigint id PK\n        bigint usuario_id FK\n        varchar nombre\n        varchar tipo\n        boolean activa\n    }\n\n    categorias {\n        bigint id PK\n        bigint usuario_id FK\n        varchar nombre\n        varchar tipo\n        boolean activa\n    }\n\n    movimientos {\n        bigint id PK\n        bigint usuario_id FK\n        bigint cuenta_id FK\n        bigint categoria_id FK\n        bigint transferencia_id FK\n        varchar tipo\n        varchar concepto\n        numeric monto\n        date fecha\n        varchar origen\n        varchar estado\n    }\n\n    transferencias {\n        bigint id PK\n        bigint usuario_id FK\n        timestamp created_at\n    }\n\n    deudas {\n        bigint id PK\n        bigint usuario_id FK\n        varchar descripcion\n        varchar acreedor\n        numeric importe_original\n        date fecha\n        varchar estado\n    }\n\n    pagos_deuda {\n        bigint id PK\n        bigint deuda_id FK\n        bigint movimiento_id FK\n        numeric importe\n        date fecha\n        varchar estado\n    }\n\n    facturas {\n        bigint id PK\n        bigint usuario_id FK\n        varchar servicio\n        numeric importe_original\n        date fecha_emision\n        date fecha_vencimiento\n        varchar estado\n    }\n\n    pagos_factura {\n        bigint id PK\n        bigint factura_id FK\n        bigint movimiento_id FK\n        numeric importe\n        date fecha\n        varchar estado\n    }\n\n    recordatorios {\n        bigint id PK\n        bigint factura_id FK\n        integer dias_anticipacion\n        timestamp fecha_programada\n        timestamp enviado_at\n        varchar estado\n    }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mCHMbzhKX5sEU5nWJobJ-1">
